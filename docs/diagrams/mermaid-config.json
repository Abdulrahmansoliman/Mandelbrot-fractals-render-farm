{
  "theme": "base",
  "look": "classic",
  "fontFamily": "Segoe UI, Arial, sans-serif",
  "themeVariables": {
    "fontFamily": "Segoe UI, Arial, sans-serif",
    "fontSize": "17px",
    "primaryColor": "#e6efff",
    "primaryTextColor": "#17243b",
    "primaryBorderColor": "#7892b8",
    "lineColor": "#536984",
    "secondaryColor": "#e4f6f1",
    "tertiaryColor": "#f8fafc",
    "clusterBkg": "#f7f9fc",
    "clusterBorder": "#b4c1d2",
    "titleColor": "#17243b",
    "edgeLabelBackground": "#ffffff",
    "actorBkg": "#e6efff",
    "actorBorder": "#7892b8",
    "actorTextColor": "#17243b",
    "actorLineColor": "#a0aec0",
    "signalColor": "#536984",
    "signalTextColor": "#17243b",
    "labelBoxBkgColor": "#f1f5f9",
    "labelBoxBorderColor": "#b4c1d2",
    "labelTextColor": "#17243b",
    "loopTextColor": "#17243b",
    "noteBkgColor": "#fff8e8",
    "noteBorderColor": "#d6b871",
    "noteTextColor": "#584620",
    "sequenceNumberColor": "#ffffff"
  },
  "flowchart": {
    "htmlLabels": false,
    "curve": "linear",
    "nodeSpacing": 38,
    "rankSpacing": 48,
    "padding": 20,
    "wrappingWidth": 320,
    "useMaxWidth": true
  },
  "sequence": {
    "useMaxWidth": true,
    "mirrorActors": false,
    "actorFontSize": 17,
    "messageFontSize": 16,
    "noteFontSize": 15,
    "messageMargin": 24,
    "actorMargin": 80,
    "width": 200,
    "diagramMarginX": 32,
    "diagramMarginY": 24,
    "wrap": false
  }
}
